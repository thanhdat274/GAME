rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function owns(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    function smallSave() {
      return request.resource.data.data is string
        && request.resource.data.data.toUtf8().size() < 900000;
    }

    match /users/{uid}/saves/main {
      allow read, delete: if owns(uid);
      allow create: if owns(uid)
        && smallSave()
        && request.resource.data.revision == 1
        && request.resource.data.data is string;
      allow update: if owns(uid)
        && smallSave()
        && request.resource.data.revision == resource.data.revision + 1
        && request.resource.data.data is string;
    }

    match /users/{uid}/meta/clock {
      allow read, delete: if owns(uid);
      allow create, update: if owns(uid)
        && request.resource.data.ping is timestamp;
    }

    // Live state is read-only to clients. Callable Functions use Admin SDK for writes.
    match /users/{uid}/live/{sessionId} {
      allow read: if owns(uid);
      allow write: if false;
    }

    match /users/{uid}/{document=**} {
      allow read, write, delete: if false;
    }

    // Bảng xếp hạng: đọc cần đăng nhập. Client tự ghi điểm của chính mình (như cloud save),
    // không qua Cloud Function nên chạy được ở gói Spark miễn phí; đổi lại rules chỉ kiểm tra
    // được hình thức dữ liệu, không đối chiếu được với bản lưu thật (đủ cho bảng xếp hạng vui).
    match /leaderboards/{uid} {
      allow read: if request.auth != null;
      allow delete: if owns(uid);
      allow create, update: if owns(uid)
        && request.resource.data.uid == uid
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() < 60
        && (request.resource.data.photoURL == null || request.resource.data.photoURL is string)
        && request.resource.data.level is int && request.resource.data.level >= 1
        && request.resource.data.day is int && request.resource.data.day >= 1
        && request.resource.data.money is number && request.resource.data.money >= 0 && request.resource.data.money < 1e15;
    }
  }
}
